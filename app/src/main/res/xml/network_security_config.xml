<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/xml/network_security_config.xml -->
<network-security-config>
    <!--
    This configuration permits unencrypted cleartext HTTP traffic specifically for the
    standard Android local emulator gateway IP address 10.0.2.2.
    This is typically used for debugging on an emulator.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
